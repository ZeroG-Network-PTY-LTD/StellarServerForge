    private void startServer() {
        // Quick start server implementation
        try {
            // Create server config from current form values
            ServerConfig config = new ServerConfig();
            config.setServerName(serverNameField.getText());
            config.setServerPath(serverPathField.getText());
            config.setMinecraftVersion((String) minecraftVersionCombo.getSelectedItem());
            config.setModLoader((ServerConfig.ModLoader) modLoaderCombo.getSelectedItem());
            config.setModLoaderVersion((String) modLoaderVersionCombo.getSelectedItem());
            config.setMaxRamGb((Integer) ramSpinner.getValue());
            config.setPort((Integer) portSpinner.getValue());
            config.setCustomJavaPath(javaPathField.getText());
            config.setJvmArgs(jvmArgsArea.getText());
            config.setAutoRestart(autoRestartCheck.isSelected());
            config.setUpnpEnabled(upnpCheck.isSelected());
            
            if (ServerManager.validateServerConfig(config)) {
                if (!ServerManager.isServerDownloaded(config)) {
                    if (!ServerManager.downloadServer(config)) {
                        JOptionPane.showMessageDialog(this, 
                            "Failed to download server!", 
                            "Download Error", 
                            JOptionPane.ERROR_MESSAGE);
                        return;
                    }
                }
                
                Process serverProcess = ServerManager.launchServer(config);
                if (serverProcess != null) {
                    JOptionPane.showMessageDialog(this, 
                        "Server started successfully!", 
                        "Server Started", 
                        JOptionPane.INFORMATION_MESSAGE);
                }
            } else {
                JOptionPane.showMessageDialog(this, 
                    "Please configure your server first!", 
                    "Configuration Required", 
                    JOptionPane.WARNING_MESSAGE);
            }
        } catch (Exception e) {
            logger.error("Error starting server: {}", e.getMessage());
            JOptionPane.showMessageDialog(this, 
                "Error starting server: " + e.getMessage(), 
                "Server Error", 
                JOptionPane.ERROR_MESSAGE);
        }
    }
    
    /**
     * Scan for local mods and display them
     */
    private void scanAndDisplayMods() {
        SwingWorker<List<ModInfo>, Void> worker = new SwingWorker<List<ModInfo>, Void>() {
            @Override
            protected List<ModInfo> doInBackground() throws Exception {
                return scanLocalMods();
            }
            
            @Override
            protected void done() {
                try {
                    List<ModInfo> mods = get();
                    updateModList(mods);
                    
                    // Show status message
                    if (mods.isEmpty()) {
                        JOptionPane.showMessageDialog(MainWindow.this, 
                            "No mods found in the server's mods directory.\n" +
                            "Make sure the server path is set correctly and there are JAR files in the mods folder.", 
                            "No Mods Found", JOptionPane.INFORMATION_MESSAGE);
                    } else {
                        logger.info("Successfully scanned {} mods", mods.size());
                    }
                } catch (Exception e) {
                    logger.error("Error scanning mods: {}", e.getMessage());
                    JOptionPane.showMessageDialog(MainWindow.this, 
                        "Error scanning mods: " + e.getMessage() + "\n\n" +
                        "Please check that:\n" +
                        "• Server path is set correctly\n" +
                        "• Mods directory exists and is accessible\n" +
                        "• You have permission to read the mods folder", 
                        "Mod Scan Error", JOptionPane.ERROR_MESSAGE);
                }
            }
        };
        worker.execute();
    }
    
    /**
     * Scan local mods directory
     */
    private List<ModInfo> scanLocalMods() {
        List<ModInfo> mods = new ArrayList<>();
        
        if (serverConfig.getServerPath() == null || serverConfig.getServerPath().trim().isEmpty()) {
            logger.warn("Server path is not set - cannot scan mods");
            return mods;
        }
        
        File modsDir = new File(serverConfig.getServerPath(), "mods");
        if (!modsDir.exists()) {
            logger.info("Mods directory does not exist: {}", modsDir.getAbsolutePath());
            return mods;
        }
        
        File[] modFiles = modsDir.listFiles((dir, name) -> name.toLowerCase().endsWith(".jar"));
        if (modFiles == null) {
            logger.warn("Unable to list files in mods directory: {}", modsDir.getAbsolutePath());
            return mods;
        }
        
        logger.info("Scanning {} JAR files in mods directory", modFiles.length);
        
        for (File modFile : modFiles) {
            try {
                ModInfo modInfo = extractModInfo(modFile);
                if (modInfo != null) {
                    mods.add(modInfo);
                }
            } catch (Exception e) {
                logger.warn("Error reading mod file {}: {}", modFile.getName(), e.getMessage());
                // Create basic mod info for unreadable files
                ModInfo basicInfo = new ModInfo();
                basicInfo.setName(modFile.getName().replaceFirst("\\.jar$", ""));
                basicInfo.setFileName(modFile.getName());
                basicInfo.setDescription("Unable to read mod information - " + e.getMessage());
                basicInfo.setFileSize(modFile.length());
                basicInfo.setSource(ModInfo.ModSource.LOCAL);
                mods.add(basicInfo);
            }
        }
        
        logger.info("Successfully scanned {} mods", mods.size());
        return mods;
    }
    
    /**
     * Extract mod information from JAR file
     */
    private ModInfo extractModInfo(File modFile) {
        ModInfo modInfo = new ModInfo();
        modInfo.setFileName(modFile.getName());
        modInfo.setName(modFile.getName().replaceFirst("\\.jar$", ""));
        modInfo.setFileSize(modFile.length());
        modInfo.setSource(ModInfo.ModSource.LOCAL);
        
        // Try to read mod metadata from various sources
        boolean foundMetadata = false;
        
        try (java.util.jar.JarFile jarFile = new java.util.jar.JarFile(modFile)) {
            // Try to read fabric.mod.json (Fabric mods)
            java.util.jar.JarEntry fabricEntry = jarFile.getJarEntry("fabric.mod.json");
            if (fabricEntry != null) {
                foundMetadata = extractFabricModInfo(jarFile, fabricEntry, modInfo);
            }
            
            // Try to read META-INF/mods.toml (Forge mods)
            if (!foundMetadata) {
                java.util.jar.JarEntry forgeEntry = jarFile.getJarEntry("META-INF/mods.toml");
                if (forgeEntry != null) {
                    foundMetadata = extractForgeModInfo(jarFile, forgeEntry, modInfo);
                }
            }
            
            // Try to read mcmod.info (Legacy Forge mods)
            if (!foundMetadata) {
                java.util.jar.JarEntry legacyEntry = jarFile.getJarEntry("mcmod.info");
                if (legacyEntry != null) {
                    foundMetadata = extractLegacyModInfo(jarFile, legacyEntry, modInfo);
                }
            }
            
            // Try to read neoforge.mods.toml (NeoForge mods)
            if (!foundMetadata) {
                java.util.jar.JarEntry neoforgeEntry = jarFile.getJarEntry("META-INF/neoforge.mods.toml");
                if (neoforgeEntry != null) {
                    foundMetadata = extractNeoForgeModInfo(jarFile, neoforgeEntry, modInfo);
                }
            }
        } catch (Exception e) {
            logger.warn("Error reading JAR file {}: {}", modFile.getName(), e.getMessage());
        }
        
        // If no metadata found, use filename-based info
        if (!foundMetadata) {
            modInfo.setDescription("Local mod file - metadata not available");
            modInfo.setVersion("Unknown");
        }
        
        return modInfo;
    }
    
    /**
     * Extract mod information from Fabric mod.json
     */
    private boolean extractFabricModInfo(java.util.jar.JarFile jarFile, java.util.jar.JarEntry entry, ModInfo modInfo) {
        try (java.io.InputStream is = jarFile.getInputStream(entry)) {
            com.google.gson.JsonObject json = new com.google.gson.Gson().fromJson(
                new java.io.InputStreamReader(is), com.google.gson.JsonObject.class);
            
            if (json.has("name")) {
                modInfo.setName(json.get("name").getAsString());
            }
            if (json.has("version")) {
                modInfo.setVersion(json.get("version").getAsString());
            }
            if (json.has("description")) {
                modInfo.setDescription(json.get("description").getAsString());
            }
            return true;
        } catch (Exception e) {
            logger.warn("Error reading fabric.mod.json: {}", e.getMessage());
            return false;
        }
    }
    
    /**
     * Extract mod information from Forge mods.toml
     */
    private boolean extractForgeModInfo(java.util.jar.JarFile jarFile, java.util.jar.JarEntry entry, ModInfo modInfo) {
        try (java.io.InputStream is = jarFile.getInputStream(entry)) {
            java.util.Scanner scanner = new java.util.Scanner(is);
            while (scanner.hasNextLine()) {
                String line = scanner.nextLine().trim();
                if (line.startsWith("displayName=")) {
                    modInfo.setName(line.substring(12).replaceAll("\"", ""));
                } else if (line.startsWith("version=")) {
                    modInfo.setVersion(line.substring(8).replaceAll("\"", ""));
                } else if (line.startsWith("description=")) {
                    modInfo.setDescription(line.substring(12).replaceAll("\"", ""));
                }
            }
            return true;
        } catch (Exception e) {
            logger.warn("Error reading mods.toml: {}", e.getMessage());
            return false;
        }
    }
    
    /**
     * Extract mod information from legacy mcmod.info
     */
    private boolean extractLegacyModInfo(java.util.jar.JarFile jarFile, java.util.jar.JarEntry entry, ModInfo modInfo) {
        try (java.io.InputStream is = jarFile.getInputStream(entry)) {
            com.google.gson.JsonArray json = new com.google.gson.Gson().fromJson(
                new java.io.InputStreamReader(is), com.google.gson.JsonArray.class);
            
            if (json.size() > 0) {
                com.google.gson.JsonObject mod = json.get(0).getAsJsonObject();
                if (mod.has("name")) {
                    modInfo.setName(mod.get("name").getAsString());
                }
                if (mod.has("version")) {
                    modInfo.setVersion(mod.get("version").getAsString());
                }
                if (mod.has("description")) {
                    modInfo.setDescription(mod.get("description").getAsString());
                }
            }
            return true;
        } catch (Exception e) {
            logger.warn("Error reading mcmod.info: {}", e.getMessage());
            return false;
        }
    }
    
    /**
     * Extract mod information from NeoForge mods.toml
     */
    private boolean extractNeoForgeModInfo(java.util.jar.JarFile jarFile, java.util.jar.JarEntry entry, ModInfo modInfo) {
        // Similar to Forge for now
        return extractForgeModInfo(jarFile, entry, modInfo);
    }
}
