    /**
     * Remove selected mods
     */
    private void removeSelectedMods() {
        // Find the mod management panel
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            if ("Mod Management".equals(tabbedPane.getTitleAt(i))) {
                JPanel modPanel = (JPanel) tabbedPane.getComponentAt(i);
                @SuppressWarnings("unchecked")
                JList<ModInfo> modList = (JList<ModInfo>) modPanel.getClientProperty("modList");
                
                if (modList != null) {
                    List<ModInfo> selectedMods = modList.getSelectedValuesList();
                    if (selectedMods.isEmpty()) {
                        JOptionPane.showMessageDialog(this, "Please select mods to remove", 
                            "No Selection", JOptionPane.WARNING_MESSAGE);
                        return;
                    }
                    
                    String message = String.format("Are you sure you want to remove %d selected mod(s)?", 
                        selectedMods.size());
                    int choice = JOptionPane.showConfirmDialog(this, message, 
                        "Confirm Remove", JOptionPane.YES_NO_OPTION);
                    
                    if (choice == JOptionPane.YES_OPTION) {
                        removeModsFromServer(selectedMods);
                    }
                }
                break;
            }
        }
    }
    
    /**
     * Remove mods from server
     */
    private void removeModsFromServer(List<ModInfo> mods) {
        SwingWorker<Void, String> worker = new SwingWorker<Void, String>() {
            @Override
            protected Void doInBackground() throws Exception {
                File modsDir = new File(serverConfig.getServerPath(), "mods");
                
                for (ModInfo mod : mods) {
                    File modFile = new File(modsDir, mod.getFileName());
                    if (modFile.exists()) {
                        if (modFile.delete()) {
                            publish("Removed: " + mod.getName());
                        } else {
                            publish("Failed to remove: " + mod.getName());
                        }
                    }
                }
                
                return null;
            }
            
            @Override
            protected void process(List<String> chunks) {
                for (String message : chunks) {
                    logger.info(message);
                }
            }
            
            @Override
            protected void done() {
                try {
                    get();
                    JOptionPane.showMessageDialog(MainWindow.this, 
                        "Selected mods have been removed", 
                        "Success", JOptionPane.INFORMATION_MESSAGE);
                    refreshModList();
                } catch (Exception e) {
                    logger.error("Error removing mods: {}", e.getMessage());
                    JOptionPane.showMessageDialog(MainWindow.this, 
                        "Error removing mods: " + e.getMessage(), 
                        "Error", JOptionPane.ERROR_MESSAGE);
                }
            }
        };
        worker.execute();
    }
    
    /**
     * Refresh mod list
     */
    private void refreshModList() {
        scanAndDisplayMods();
    }
    
    /**
     * Format file size for display
     */
    private String formatFileSize(long size) {
        if (size <= 0) return "0 B";
        
        String[] units = {"B", "KB", "MB", "GB"};
        int unitIndex = 0;
        double fileSize = size;
        
        while (fileSize >= 1024 && unitIndex < units.length - 1) {
            fileSize /= 1024;
            unitIndex++;
        }
        
        return String.format("%.1f %s", fileSize, units[unitIndex]);
    }
    
    /**
     * Custom cell renderer for mod list
     */
    private static class ModListCellRenderer extends DefaultListCellRenderer {
        @Override
        public Component getListCellRendererComponent(JList<?> list, Object value, int index,
                boolean isSelected, boolean cellHasFocus) {
            super.getListCellRendererComponent(list, value, index, isSelected, cellHasFocus);
            
            if (value instanceof ModInfo) {
                ModInfo mod = (ModInfo) value;
                setText(mod.getName() + " (" + mod.getFileName() + ")");
                setToolTipText(mod.getDescription());
            }
            
            return this;
        }
    }
    
    /**
     * Load and scale the application logo
     * @param size The desired size for the logo (width and height will be the same)
     * @return ImageIcon with the scaled logo, or null if logo cannot be loaded
     */
    private ImageIcon loadScaledLogo(int size) {
        try {
            InputStream logoStream = getClass().getResourceAsStream("/images/stellar-logo.png");
            if (logoStream != null) {
                BufferedImage logo = ImageIO.read(logoStream);
                logoStream.close();
                Image scaledLogo = logo.getScaledInstance(size, size, Image.SCALE_SMOOTH);
                return new ImageIcon(scaledLogo);
            }
        } catch (IOException e) {
            logger.warn("Could not load logo: {}", e.getMessage());
        }
        return null;
    }
    
    private JPanel createHomePanel() {
        JPanel homePanel = new JPanel(new BorderLayout());
        homePanel.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));
        
        // Welcome header
        JPanel welcomePanel = new JPanel(new FlowLayout(FlowLayout.CENTER));
        welcomePanel.setBackground(new Color(240, 248, 255));
        welcomePanel.setBorder(BorderFactory.createLineBorder(new Color(70, 130, 180), 2));
        
        JLabel welcomeLabel = new JLabel("🌟 Welcome to Stellar Server Forge 🌟");
        welcomeLabel.setFont(new Font("Arial", Font.BOLD, 24));
        welcomeLabel.setForeground(new Color(25, 25, 112));
        welcomePanel.add(welcomeLabel);
        
        homePanel.add(welcomePanel, BorderLayout.NORTH);
        
        // Main content area
        JPanel contentPanel = new JPanel(new GridBagLayout());
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(10, 10, 10, 10);
        gbc.fill = GridBagConstraints.BOTH;
        
        // Quick Stats Panel
        JPanel statsPanel = createQuickStatsPanel();
        gbc.gridx = 0; gbc.gridy = 0; gbc.weightx = 0.5; gbc.weighty = 0.3;
        contentPanel.add(statsPanel, gbc);
        
        // Recent Activity Panel
        JPanel activityPanel = createRecentActivityPanel();
        gbc.gridx = 1; gbc.gridy = 0; gbc.weightx = 0.5; gbc.weighty = 0.3;
        contentPanel.add(activityPanel, gbc);
        
        // Quick Actions Panel
        JPanel actionsPanel = createQuickActionsPanel();
        gbc.gridx = 0; gbc.gridy = 1; gbc.gridwidth = 2; gbc.weightx = 1.0; gbc.weighty = 0.7;
        contentPanel.add(actionsPanel, gbc);
        
        homePanel.add(contentPanel, BorderLayout.CENTER);
        
        return homePanel;
    }
    
    private JPanel createQuickStatsPanel() {
        JPanel panel = new JPanel(new BorderLayout());
        panel.setBorder(BorderFactory.createTitledBorder("📊 Quick Stats"));
        panel.setBackground(Color.WHITE);
        
        JPanel statsContent = new JPanel(new GridLayout(4, 1, 5, 5));
        statsContent.setBackground(Color.WHITE);
        
        // Server Status
        JLabel serverStatusLabel = new JLabel("Server Status: Offline");
        serverStatusLabel.setFont(new Font("Arial", Font.PLAIN, 12));
        serverStatusLabel.setForeground(Color.RED);
        statsContent.add(serverStatusLabel);
        
        // Mod Count
        JLabel modCountLabel = new JLabel("Installed Mods: 0");
        modCountLabel.setFont(new Font("Arial", Font.PLAIN, 12));
        statsContent.add(modCountLabel);
        
        // Last Launch
        JLabel lastLaunchLabel = new JLabel("Last Launch: Never");
        lastLaunchLabel.setFont(new Font("Arial", Font.PLAIN, 12));
        statsContent.add(lastLaunchLabel);
        
        // Version Info
        JLabel versionLabel = new JLabel("Version: Loading...");
        versionLabel.setFont(new Font("Arial", Font.PLAIN, 12));
        statsContent.add(versionLabel);
        
        panel.add(statsContent, BorderLayout.CENTER);
        
        // Update version info asynchronously
        SwingWorker<String, Void> versionWorker = new SwingWorker<String, Void>() {
            @Override
            protected String doInBackground() throws Exception {
                String mcVersion = (String) minecraftVersionCombo.getSelectedItem();
                if (mcVersion == null) mcVersion = "1.21.1";
                
                List<String> versions = versionFetcher.getModLoaderVersions("neoforge", mcVersion);
                if (!versions.isEmpty()) {
                    return versions.get(0); // Get the latest version
                }
                return "Unknown";
            }
            
            @Override
            protected void done() {
                try {
                    String version = get();
                    String mcVersion = (String) minecraftVersionCombo.getSelectedItem();
                    if (mcVersion == null) mcVersion = "1.21.1";
                    versionLabel.setText("Latest NeoForge for " + mcVersion + ": " + version);
                } catch (Exception e) {
                    versionLabel.setText("Latest NeoForge: Error loading");
                }
            }
        };
        versionWorker.execute();
        
        return panel;
    }
    
