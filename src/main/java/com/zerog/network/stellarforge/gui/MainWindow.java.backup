    /**
     * Open mod folder in file explorer
     */
    private void openModFolder() {
        try {
            File modsDir = new File(serverConfig.getServerPath(), "mods");
            if (modsDir.exists()) {
                Desktop.getDesktop().open(modsDir);
            } else {
                JOptionPane.showMessageDialog(this, 
                    "Mods directory does not exist: " + modsDir.getAbsolutePath(), 
                    "Directory Not Found", JOptionPane.WARNING_MESSAGE);
            }
        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, 
                "Error opening mods folder: " + e.getMessage(), 
                "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    /**
     * Update mod list display
     */
    private void updateModList(List<ModInfo> mods) {
        // Find the mod management panel
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            if ("Mod Management".equals(tabbedPane.getTitleAt(i))) {
                JPanel modPanel = (JPanel) tabbedPane.getComponentAt(i);
                @SuppressWarnings("unchecked")
                JList<ModInfo> modList = (JList<ModInfo>) modPanel.getClientProperty("modList");
                
                if (modList != null) {
                    DefaultListModel<ModInfo> model = (DefaultListModel<ModInfo>) modList.getModel();
                    model.clear();
                    for (ModInfo mod : mods) {
                        model.addElement(mod);
                    }
                    
                    // Update status
                    JTextArea detailsArea = (JTextArea) modPanel.getClientProperty("modDetailsArea");
                    if (detailsArea != null) {
                        detailsArea.setText(String.format("Found %d mods in server directory", mods.size()));
                    }
                }
                break;
            }
        }
    }
    
    /**
     * Update mod details display
     */
    private void updateModDetails(ModInfo mod) {
        if (mod == null) {
            return;
        }
        
        // Find the mod management panel
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            if ("Mod Management".equals(tabbedPane.getTitleAt(i))) {
                JPanel modPanel = (JPanel) tabbedPane.getComponentAt(i);
                JTextArea detailsArea = (JTextArea) modPanel.getClientProperty("modDetailsArea");
                
                if (detailsArea != null) {
                    StringBuilder details = new StringBuilder();
                    details.append("Name: ").append(mod.getName()).append("\n");
                    details.append("File: ").append(mod.getFileName()).append("\n");
                    details.append("Size: ").append(formatFileSize(mod.getFileSize())).append("\n");
                    if (mod.getVersion() != null) {
                        details.append("Version: ").append(mod.getVersion()).append("\n");
                    }
                    if (mod.getDescription() != null) {
                        details.append("Description: ").append(mod.getDescription()).append("\n");
                    }
                    if (mod.getProjectId() != null) {
                        details.append("Project ID: ").append(mod.getProjectId()).append("\n");
