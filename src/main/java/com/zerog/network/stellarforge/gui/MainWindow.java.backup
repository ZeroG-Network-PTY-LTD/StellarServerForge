    private void startServer() {
        // Quick start server implementation
        try {
            // Create server config from current form values
            ServerConfig config = new ServerConfig();
            config.setServerName(serverNameField.getText());
            config.setServerPath(serverPathField.getText());
            config.setMinecraftVersion((String) minecraftVersionCombo.getSelectedItem());
            config.setModLoader((ServerConfig.ModLoader) modLoaderCombo.getSelectedItem());
            config.setModLoaderVersion((String) modLoaderVersionCombo.getSelectedItem());
            config.setMaxRamGb((Integer) ramSpinner.getValue());
            config.setPort((Integer) portSpinner.getValue());
            config.setCustomJavaPath(javaPathField.getText());
            config.setJvmArgs(jvmArgsArea.getText());
            config.setAutoRestart(autoRestartCheck.isSelected());
            config.setUpnpEnabled(upnpCheck.isSelected());
            
            if (ServerManager.validateServerConfig(config)) {
                if (!ServerManager.isServerDownloaded(config)) {
                    if (!ServerManager.downloadServer(config)) {
                        JOptionPane.showMessageDialog(this, 
                            "Failed to download server!", 
                            "Download Error", 
                            JOptionPane.ERROR_MESSAGE);
                        return;
                    }
                }
                
                Process serverProcess = ServerManager.launchServer(config);
                if (serverProcess != null) {
                    JOptionPane.showMessageDialog(this, 
                        "Server started successfully!", 
                        "Server Started", 
                        JOptionPane.INFORMATION_MESSAGE);
                }
            } else {
                JOptionPane.showMessageDialog(this, 
                    "Please configure your server first!", 
                    "Configuration Required", 
                    JOptionPane.WARNING_MESSAGE);
            }
        } catch (Exception e) {
            logger.error("Error starting server: {}", e.getMessage());
            JOptionPane.showMessageDialog(this, 
                "Error starting server: " + e.getMessage(), 
                "Server Error", 
                JOptionPane.ERROR_MESSAGE);
        }
    }
    
    /**
     * Scan for local mods and display them
     */
    private void scanAndDisplayMods() {
        SwingWorker<List<ModInfo>, Void> worker = new SwingWorker<List<ModInfo>, Void>() {
            @Override
            protected List<ModInfo> doInBackground() throws Exception {
                return scanLocalMods();
            }
            
            @Override
            protected void done() {
                try {
                    List<ModInfo> mods = get();
                    updateModList(mods);
                    
                    // Show status message
                    if (mods.isEmpty()) {
                        JOptionPane.showMessageDialog(MainWindow.this, 
                            "No mods found in the server's mods directory.\n" +
                            "Make sure the server path is set correctly and there are JAR files in the mods folder.", 
                            "No Mods Found", JOptionPane.INFORMATION_MESSAGE);
                    } else {
                        logger.info("Successfully scanned {} mods", mods.size());
                    }
                } catch (Exception e) {
                    logger.error("Error scanning mods: {}", e.getMessage());
                    JOptionPane.showMessageDialog(MainWindow.this, 
                        "Error scanning mods: " + e.getMessage() + "\n\n" +
                        "Please check that:\n" +
                        "• Server path is set correctly\n" +
                        "• Mods directory exists and is accessible\n" +
                        "• You have permission to read the mods folder", 
                        "Mod Scan Error", JOptionPane.ERROR_MESSAGE);
                }
            }
        };
        worker.execute();
    }
    
    /**
     * Scan local mods directory
     */
    private List<ModInfo> scanLocalMods() {
        List<ModInfo> mods = new ArrayList<>();
        
        if (serverConfig.getServerPath() == null || serverConfig.getServerPath().trim().isEmpty()) {
            logger.warn("Server path is not set - cannot scan mods");
            return mods;
        }
        
        File modsDir = new File(serverConfig.getServerPath(), "mods");
        if (!modsDir.exists()) {
            logger.info("Mods directory does not exist: {}", modsDir.getAbsolutePath());
            return mods;
        }
        
        File[] modFiles = modsDir.listFiles((dir, name) -> name.toLowerCase().endsWith(".jar"));
        if (modFiles == null) {
            logger.warn("Unable to list files in mods directory: {}", modsDir.getAbsolutePath());
            return mods;
        }
        
        logger.info("Scanning {} JAR files in mods directory", modFiles.length);
        
        for (File modFile : modFiles) {
            try {
                ModInfo modInfo = extractModInfo(modFile);
                if (modInfo != null) {
                    mods.add(modInfo);
                }
            } catch (Exception e) {
                logger.warn("Error reading mod file {}: {}", modFile.getName(), e.getMessage());
                // Create basic mod info for unreadable files
                ModInfo basicInfo = new ModInfo();
                basicInfo.setName(modFile.getName().replaceFirst("\\.jar$", ""));
                basicInfo.setFileName(modFile.getName());
                basicInfo.setDescription("Unable to read mod information - " + e.getMessage());
                basicInfo.setFileSize(modFile.length());
                basicInfo.setSource(ModInfo.ModSource.LOCAL);
                mods.add(basicInfo);
            }
        }
        
        logger.info("Successfully scanned {} mods", mods.size());
        return mods;
    }
    
    /**
     * Extract mod information from JAR file
     */
    private ModInfo extractModInfo(File modFile) {
        ModInfo modInfo = new ModInfo();
        modInfo.setFileName(modFile.getName());
        modInfo.setName(modFile.getName().replaceFirst("\\.jar$", ""));
        modInfo.setFileSize(modFile.length());
        modInfo.setSource(ModInfo.ModSource.LOCAL);
        
        // Try to read mod metadata from various sources
        boolean foundMetadata = false;
        
        try (java.util.jar.JarFile jarFile = new java.util.jar.JarFile(modFile)) {
            // Try to read fabric.mod.json (Fabric mods)
            java.util.jar.JarEntry fabricEntry = jarFile.getJarEntry("fabric.mod.json");
            if (fabricEntry != null) {
                foundMetadata = extractFabricModInfo(jarFile, fabricEntry, modInfo);
            }
            
            // Try to read META-INF/mods.toml (Forge mods)
            if (!foundMetadata) {
                java.util.jar.JarEntry forgeEntry = jarFile.getJarEntry("META-INF/mods.toml");
                if (forgeEntry != null) {
                    foundMetadata = extractForgeModInfo(jarFile, forgeEntry, modInfo);
                }
            }
            
            // Try to read mcmod.info (Legacy Forge mods)
            if (!foundMetadata) {
                java.util.jar.JarEntry legacyEntry = jarFile.getJarEntry("mcmod.info");
                if (legacyEntry != null) {
                    foundMetadata = extractLegacyModInfo(jarFile, legacyEntry, modInfo);
                }
            }
            
            // Try to read neoforge.mods.toml (NeoForge mods)
            if (!foundMetadata) {
                java.util.jar.JarEntry neoforgeEntry = jarFile.getJarEntry("META-INF/neoforge.mods.toml");
                if (neoforgeEntry != null) {
                    foundMetadata = extractNeoForgeModInfo(jarFile, neoforgeEntry, modInfo);
                }
            }
        } catch (Exception e) {
            logger.warn("Error reading JAR file {}: {}", modFile.getName(), e.getMessage());
        }
        
        // If no metadata found, use filename-based info
        if (!foundMetadata) {
            modInfo.setDescription("Local mod file - metadata not available");
            modInfo.setVersion("Unknown");
        }
        
        return modInfo;
    }
    
    /**
     * Extract mod information from Fabric mod.json
     */
    private boolean extractFabricModInfo(java.util.jar.JarFile jarFile, java.util.jar.JarEntry entry, ModInfo modInfo) {
        try (java.io.InputStream is = jarFile.getInputStream(entry)) {
            com.google.gson.JsonObject json = new com.google.gson.Gson().fromJson(
                new java.io.InputStreamReader(is), com.google.gson.JsonObject.class);
            
            if (json.has("name")) {
                modInfo.setName(json.get("name").getAsString());
            }
            if (json.has("version")) {
                modInfo.setVersion(json.get("version").getAsString());
            }
            if (json.has("description")) {
                modInfo.setDescription(json.get("description").getAsString());
            }
            return true;
        } catch (Exception e) {
            logger.warn("Error reading fabric.mod.json: {}", e.getMessage());
            return false;
        }
    }
    
    /**
     * Extract mod information from Forge mods.toml
     */
    private boolean extractForgeModInfo(java.util.jar.JarFile jarFile, java.util.jar.JarEntry entry, ModInfo modInfo) {
        try (java.io.InputStream is = jarFile.getInputStream(entry)) {
            java.util.Scanner scanner = new java.util.Scanner(is);
            while (scanner.hasNextLine()) {
                String line = scanner.nextLine().trim();
                if (line.startsWith("displayName=")) {
                    modInfo.setName(line.substring(12).replaceAll("\"", ""));
                } else if (line.startsWith("version=")) {
                    modInfo.setVersion(line.substring(8).replaceAll("\"", ""));
                } else if (line.startsWith("description=")) {
                    modInfo.setDescription(line.substring(12).replaceAll("\"", ""));
                }
            }
            return true;
        } catch (Exception e) {
            logger.warn("Error reading mods.toml: {}", e.getMessage());
            return false;
        }
    }
    
    /**
     * Extract mod information from legacy mcmod.info
     */
    private boolean extractLegacyModInfo(java.util.jar.JarFile jarFile, java.util.jar.JarEntry entry, ModInfo modInfo) {
        try (java.io.InputStream is = jarFile.getInputStream(entry)) {
            com.google.gson.JsonArray json = new com.google.gson.Gson().fromJson(
                new java.io.InputStreamReader(is), com.google.gson.JsonArray.class);
            
            if (json.size() > 0) {
                com.google.gson.JsonObject mod = json.get(0).getAsJsonObject();
                if (mod.has("name")) {
                    modInfo.setName(mod.get("name").getAsString());
                }
                if (mod.has("version")) {
                    modInfo.setVersion(mod.get("version").getAsString());
                }
                if (mod.has("description")) {
                    modInfo.setDescription(mod.get("description").getAsString());
                }
            }
            return true;
        } catch (Exception e) {
            logger.warn("Error reading mcmod.info: {}", e.getMessage());
            return false;
        }
    }
    
    /**
     * Extract mod information from NeoForge mods.toml
     */
    private boolean extractNeoForgeModInfo(java.util.jar.JarFile jarFile, java.util.jar.JarEntry entry, ModInfo modInfo) {
        // Similar to Forge for now
        return extractForgeModInfo(jarFile, entry, modInfo);
    }
    
    /**
     * Filter the mod table based on search text
     */
    private void filterModTable(String searchText) {
        // Find the mod table
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            if ("Mod Management".equals(tabbedPane.getTitleAt(i))) {
                JPanel modPanel = (JPanel) tabbedPane.getComponentAt(i);
                JSplitPane splitPane = (JSplitPane) modPanel.getComponent(1);
                JPanel tablePanel = (JPanel) splitPane.getTopComponent();
                JTable modTable = (JTable) tablePanel.getClientProperty("modTable");
                
                if (modTable != null) {
                    TableRowSorter<DefaultTableModel> sorter = 
                        (TableRowSorter<DefaultTableModel>) modTable.getRowSorter();
                    
                    if (searchText.trim().isEmpty()) {
                        sorter.setRowFilter(null);
                    } else {
                        sorter.setRowFilter(RowFilter.regexFilter("(?i)" + searchText));
                    }
                }
                break;
            }
        }
    }
    
    /**
     * Show dialog to add a new mod
     */
    private void showAddModDialog() {
        JDialog dialog = new JDialog(this, "Add Mod", true);
        dialog.setSize(500, 400);
        dialog.setLocationRelativeTo(this);
        
        JPanel panel = new JPanel(new BorderLayout());
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        
        // Create tabbed pane for different add methods
        JTabbedPane tabs = new JTabbedPane();
        
        // File upload tab
        JPanel fileTab = new JPanel(new BorderLayout());
        JPanel filePanel = new JPanel(new FlowLayout());
        JTextField fileField = new JTextField(30);
        fileField.setEditable(false);
        JButton browseButton = new JButton("Browse");
        browseButton.addActionListener(e -> {
            JFileChooser chooser = new JFileChooser();
            chooser.setFileFilter(new javax.swing.filechooser.FileNameExtensionFilter("JAR files", "jar"));
            if (chooser.showOpenDialog(dialog) == JFileChooser.APPROVE_OPTION) {
                fileField.setText(chooser.getSelectedFile().getAbsolutePath());
            }
        });
        filePanel.add(new JLabel("Select JAR file:"));
        filePanel.add(fileField);
        filePanel.add(browseButton);
        fileTab.add(filePanel, BorderLayout.NORTH);
        
        JTextArea fileInfo = new JTextArea("Select a JAR file to view its information");
        fileInfo.setEditable(false);
        fileTab.add(new JScrollPane(fileInfo), BorderLayout.CENTER);
        
        tabs.addTab("Upload File", fileTab);
        
        // URL download tab
        JPanel urlTab = new JPanel(new BorderLayout());
        JPanel urlPanel = new JPanel(new FlowLayout());
        JTextField urlField = new JTextField(40);
        urlField.setToolTipText("Enter direct download URL for the mod");
        urlPanel.add(new JLabel("Download URL:"));
        urlPanel.add(urlField);
        urlTab.add(urlPanel, BorderLayout.NORTH);
        
        JTextArea urlInfo = new JTextArea("Enter a direct download URL for the mod JAR file");
        urlInfo.setEditable(false);
        urlTab.add(new JScrollPane(urlInfo), BorderLayout.CENTER);
        
        tabs.addTab("Download URL", urlTab);
        
        panel.add(tabs, BorderLayout.CENTER);
        
        // Buttons
        JPanel buttonPanel = new JPanel(new FlowLayout());
        JButton addButton = new JButton("Add Mod");
        addButton.addActionListener(e -> {
            int selectedTab = tabs.getSelectedIndex();
            if (selectedTab == 0) { // File upload
                String filePath = fileField.getText();
                if (!filePath.isEmpty()) {
                    addModFromFile(filePath);
                    dialog.dispose();
                }
            } else if (selectedTab == 1) { // URL download
                String url = urlField.getText();
                if (!url.isEmpty()) {
                    addModFromURL(url);
                    dialog.dispose();
                }
            }
        });
        
        JButton cancelButton = new JButton("Cancel");
        cancelButton.addActionListener(e -> dialog.dispose());
        
        buttonPanel.add(addButton);
        buttonPanel.add(cancelButton);
        panel.add(buttonPanel, BorderLayout.SOUTH);
        
        dialog.add(panel);
        dialog.setVisible(true);
    }
    
    /**
     * Add mod from local file
     */
    private void addModFromFile(String filePath) {
        SwingWorker<Void, Void> worker = new SwingWorker<Void, Void>() {
            @Override
            protected Void doInBackground() throws Exception {
                File sourceFile = new File(filePath);
                if (!sourceFile.exists()) {
                    throw new Exception("File does not exist: " + filePath);
                }
                
                File modsDir = new File(serverConfig.getServerPath(), "mods");
                if (!modsDir.exists()) {
                    modsDir.mkdirs();
                }
                
                File destFile = new File(modsDir, sourceFile.getName());
                java.nio.file.Files.copy(sourceFile.toPath(), destFile.toPath(), 
                    java.nio.file.StandardCopyOption.REPLACE_EXISTING);
                
                return null;
            }
            
            @Override
            protected void done() {
                try {
                    get();
                    JOptionPane.showMessageDialog(MainWindow.this, 
                        "Mod added successfully!", "Success", JOptionPane.INFORMATION_MESSAGE);
                    scanAndDisplayMods();
                } catch (Exception e) {
                    JOptionPane.showMessageDialog(MainWindow.this, 
                        "Error adding mod: " + e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
                }
            }
        };
        worker.execute();
    }
    
    /**
     * Add mod from URL
     */
    private void addModFromURL(String url) {
        SwingWorker<Void, Void> worker = new SwingWorker<Void, Void>() {
            @Override
            protected Void doInBackground() throws Exception {
                java.net.URL downloadUrl = new java.net.URL(url);
                String fileName = url.substring(url.lastIndexOf('/') + 1);
                if (!fileName.endsWith(".jar")) {
                    fileName += ".jar";
                }
                
                File modsDir = new File(serverConfig.getServerPath(), "mods");
                if (!modsDir.exists()) {
                    modsDir.mkdirs();
                }
                
                File destFile = new File(modsDir, fileName);
                
                try (java.io.InputStream in = downloadUrl.openStream();
                     java.io.FileOutputStream out = new java.io.FileOutputStream(destFile)) {
                    byte[] buffer = new byte[8192];
                    int bytesRead;
                    while ((bytesRead = in.read(buffer)) != -1) {
                        out.write(buffer, 0, bytesRead);
                    }
                }
                
                return null;
            }
            
            @Override
            protected void done() {
                try {
                    get();
                    JOptionPane.showMessageDialog(MainWindow.this, 
                        "Mod downloaded and added successfully!", "Success", JOptionPane.INFORMATION_MESSAGE);
                    scanAndDisplayMods();
                } catch (Exception e) {
                    JOptionPane.showMessageDialog(MainWindow.this, 
                        "Error downloading mod: " + e.getMessage(), "Error", JOptionPane.ERROR_MESSAGE);
                }
            }
        };
        worker.execute();
    }
    
    /**
     * Load and scale logo image
     */
    private ImageIcon loadScaledLogo(int size) {
        try {
            InputStream logoStream = getClass().getResourceAsStream("/logo.png");
            if (logoStream == null) {
                return createDefaultIcon(size);
            }
            
            BufferedImage logo = ImageIO.read(logoStream);
            Image scaledLogo = logo.getScaledInstance(size, size, Image.SCALE_SMOOTH);
            return new ImageIcon(scaledLogo);
        } catch (IOException e) {
            return createDefaultIcon(size);
        }
    }
    
    /**
     * Create default icon when logo is not available
     */
    private ImageIcon createDefaultIcon(int size) {
        BufferedImage defaultIcon = new BufferedImage(size, size, BufferedImage.TYPE_INT_ARGB);
        Graphics2D g2d = defaultIcon.createGraphics();
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        
        // Draw a simple star-like shape
        g2d.setColor(new Color(255, 215, 0)); // Gold color
        g2d.fillOval(size/4, size/4, size/2, size/2);
        
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Arial", Font.BOLD, size/4));
        FontMetrics fm = g2d.getFontMetrics();
        String text = "S";
        int textWidth = fm.stringWidth(text);
        int textHeight = fm.getAscent();
        g2d.drawString(text, (size - textWidth) / 2, (size + textHeight) / 2);
        
        g2d.dispose();
        return new ImageIcon(defaultIcon);
    }
    
    /**
     * Remove selected mods
     */
    private void removeSelectedMods() {
        // Find the mod table and get selected rows
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            if ("Mod Management".equals(tabbedPane.getTitleAt(i))) {
                JPanel modPanel = (JPanel) tabbedPane.getComponentAt(i);
                JSplitPane splitPane = (JSplitPane) modPanel.getComponent(1);
                JPanel tablePanel = (JPanel) splitPane.getTopComponent();
                JTable modTable = (JTable) tablePanel.getClientProperty("modTable");
                
                if (modTable != null) {
                    int[] selectedRows = modTable.getSelectedRows();
                    if (selectedRows.length > 0) {
                        int result = JOptionPane.showConfirmDialog(this,
                            "Are you sure you want to remove " + selectedRows.length + " mod(s)?",
                            "Confirm Removal", JOptionPane.YES_NO_OPTION);
                        
                        if (result == JOptionPane.YES_OPTION) {
                            // Remove selected mods
                            for (int row : selectedRows) {
                                ModInfo mod = getModFromTableRow(row);
                                if (mod != null) {
                                    removeModFile(mod);
                                }
                            }
                            scanAndDisplayMods();
                        }
                    }
                }
                break;
            }
        }
    }
    
    /**
     * Remove mod file from filesystem
     */
    private void removeModFile(ModInfo mod) {
        try {
            File modFile = new File(mod.getFilePath());
            if (modFile.exists()) {
                modFile.delete();
            }
        } catch (Exception e) {
            JOptionPane.showMessageDialog(this,
                "Error removing mod: " + e.getMessage(),
                "Error", JOptionPane.ERROR_MESSAGE);
        }
    }
    
    /**
     * Update mod details panel
     */
    private void updateModDetails(ModInfo mod) {
        // Find the mod details panel and update it
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            if ("Mod Management".equals(tabbedPane.getTitleAt(i))) {
                JPanel modPanel = (JPanel) tabbedPane.getComponentAt(i);
                JSplitPane splitPane = (JSplitPane) modPanel.getComponent(1);
                JPanel detailsPanel = (JPanel) splitPane.getBottomComponent();
                
                // Update details panel content
                detailsPanel.removeAll();
                if (mod != null) {
                    JTabbedPane detailsTabs = new JTabbedPane();
                    
                    // Info tab
                    JPanel infoPanel = new JPanel(new GridBagLayout());
                    GridBagConstraints gbc = new GridBagConstraints();
                    gbc.insets = new Insets(5, 5, 5, 5);
                    gbc.anchor = GridBagConstraints.WEST;
                    
                    gbc.gridx = 0; gbc.gridy = 0;
                    infoPanel.add(new JLabel("Name:"), gbc);
                    gbc.gridx = 1;
                    infoPanel.add(new JLabel(mod.getName()), gbc);
                    
                    gbc.gridx = 0; gbc.gridy = 1;
                    infoPanel.add(new JLabel("Version:"), gbc);
                    gbc.gridx = 1;
                    infoPanel.add(new JLabel(mod.getVersion() != null ? mod.getVersion() : "Unknown"), gbc);
                    
                    gbc.gridx = 0; gbc.gridy = 2;
                    infoPanel.add(new JLabel("File:"), gbc);
                    gbc.gridx = 1;
                    infoPanel.add(new JLabel(mod.getFileName()), gbc);
                    
                    detailsTabs.addTab("Info", infoPanel);
                    
                    // Description tab
                    JTextArea descArea = new JTextArea(mod.getDescription() != null ? mod.getDescription() : "No description available");
                    descArea.setWrapStyleWord(true);
                    descArea.setLineWrap(true);
                    descArea.setEditable(false);
                    detailsTabs.addTab("Description", new JScrollPane(descArea));
                    
                    detailsPanel.add(detailsTabs, BorderLayout.CENTER);
                } else {
                    detailsPanel.add(new JLabel("No mod selected"), BorderLayout.CENTER);
                }
                
                detailsPanel.revalidate();
                detailsPanel.repaint();
                break;
            }
        }
    }
    
    /**
     * Refresh mod list
     */
    private void refreshModList() {
        scanAndDisplayMods();
    }
    
    /**
     * Update mod list in table
     */
    private void updateModList(List<ModInfo> mods) {
        // Find the mod table and update it
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            if ("Mod Management".equals(tabbedPane.getTitleAt(i))) {
                JPanel modPanel = (JPanel) tabbedPane.getComponentAt(i);
                JSplitPane splitPane = (JSplitPane) modPanel.getComponent(1);
                JPanel tablePanel = (JPanel) splitPane.getTopComponent();
                DefaultTableModel tableModel = (DefaultTableModel) tablePanel.getClientProperty("tableModel");
                
                if (tableModel != null) {
                    tableModel.setRowCount(0);
                    
                    for (ModInfo mod : mods) {
                        Object[] row = {
                            true, // Enabled
                            mod.getName(),
                            mod.getVersion() != null ? mod.getVersion() : "Unknown",
                            mod.getPlatform() != null ? mod.getPlatform() : "Unknown",
                            formatFileSize(mod.getFileSize()),
                            mod.getSource() != null ? mod.getSource() : "Local"
                        };
                        tableModel.addRow(row);
                    }
                }
                break;
            }
        }
    }
    
    /**
     * Format file size for display
     */
    private String formatFileSize(long size) {
        if (size < 1024) return size + " B";
        int exp = (int) (Math.log(size) / Math.log(1024));
        String pre = "KMGTPE".charAt(exp - 1) + "";
        return String.format("%.1f %sB", size / Math.pow(1024, exp), pre);
    }
    
    /**
     * Get mod from table row
     */
    private ModInfo getModFromTableRow(int row) {
        // Find the mod table and get the mod info
        for (int i = 0; i < tabbedPane.getTabCount(); i++) {
            if ("Mod Management".equals(tabbedPane.getTitleAt(i))) {
                JPanel modPanel = (JPanel) tabbedPane.getComponentAt(i);
                JSplitPane splitPane = (JSplitPane) modPanel.getComponent(1);
                JPanel tablePanel = (JPanel) splitPane.getTopComponent();
                DefaultTableModel tableModel = (DefaultTableModel) tablePanel.getClientProperty("tableModel");
                
                if (tableModel != null && row < tableModel.getRowCount()) {
                    String modName = (String) tableModel.getValueAt(row, 1);
                    String modVersion = (String) tableModel.getValueAt(row, 2);
                    
                    // Find the actual ModInfo object from our scanned mods
                    // This is a simplified approach - in a real implementation you'd store ModInfo objects
                    ModInfo mod = new ModInfo();
                    mod.setName(modName);
                    mod.setVersion(modVersion);
                    return mod;
                }
                break;
            }
        }
        return null;
    }
    
    /**
     * Show detailed mod information dialog
     */
    private void showModDetailsDialog(ModInfo mod) {
        if (mod == null) return;
        
        JDialog dialog = new JDialog(this, "Mod Details: " + mod.getName(), true);
        dialog.setSize(600, 500);
        dialog.setLocationRelativeTo(this);
        
        JPanel panel = new JPanel(new BorderLayout());
        panel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));
        
        // Create detailed information display
        JTextArea detailsArea = new JTextArea();
        detailsArea.setEditable(false);
        detailsArea.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 12));
        
        StringBuilder details = new StringBuilder();
        details.append("Mod Name: ").append(mod.getName()).append("\n");
        details.append("Version: ").append(mod.getVersion() != null ? mod.getVersion() : "Unknown").append("\n");
        details.append("File Name: ").append(mod.getFileName()).append("\n");
        details.append("File Size: ").append(formatFileSize(mod.getFileSize())).append("\n");
        details.append("Platform: ").append(mod.getPlatform() != null ? mod.getPlatform() : "Unknown").append("\n");
        details.append("Source: ").append(mod.getSource() != null ? mod.getSource() : "Unknown").append("\n");
        if (mod.getDescription() != null) {
            details.append("\nDescription:\n").append(mod.getDescription()).append("\n");
        }
        
        detailsArea.setText(details.toString());
        
        panel.add(new JScrollPane(detailsArea), BorderLayout.CENTER);
        
        // Close button
        JButton closeButton = new JButton("Close");
        closeButton.addActionListener(e -> dialog.dispose());
        JPanel buttonPanel = new JPanel(new FlowLayout());
        buttonPanel.add(closeButton);
        panel.add(buttonPanel, BorderLayout.SOUTH);
        
        dialog.add(panel);
        dialog.setVisible(true);
    }
    
